# Makes bare `docker compose ...` use docker-compose.dev.yml instead of the
# production docker-compose.yml. Override with an explicit -f when needed.
COMPOSE_FILE=docker-compose.dev.yml

# These do not need to be set for most local development setups, as the
# dev docker compose configuration handles most of the necessary ones for
# us. However, in some more advanced setups you may want to tweak these.
#M5KA_BASE_URL=http://m5ka.dev
#M5KA_SECRET_KEY=m5ka-secret-key-nc2f8gebz39u
#M5KA_ALLOWED_HOSTS=m5ka.dev
#M5KA_CSRF_ORIGINS=https://m5ka.dev
